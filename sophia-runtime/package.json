{
  "name": "sophia-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sophia Runtime API for realtime assistant sessions, provider adapters, and tool orchestration.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.2.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "@types/pg": "^8.11.10",
    "jest": "30.5.0",
    "ts-jest": "29.4.12",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
