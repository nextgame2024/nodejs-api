PORT=3400
CORS_ORIGINS=http://localhost:4200
SOPHIA_RUNTIME_DATABASE_URL=
SOPHIA_RUNTIME_DB_SSL=true
SOPHIA_RUNTIME_DB_POOL_SIZE=5
# Reuse idle connections for 60 seconds to avoid repeated connection handshakes.
# Bounded to 1-300 seconds; pool size is unchanged.
SOPHIA_RUNTIME_DB_IDLE_TIMEOUT_MS=60000
SOPHIA_RUNTIME_SCHEMA=sophia_runtime
# Effective least-privilege role used by runtime connections. Keep migration connections on the owner role.
SOPHIA_RUNTIME_DATABASE_ROLE=sophia_runtime_app
# Temporary Student Operations request logs + Server-Timing response headers.
# Join browser HAR and Runtime logs with scripts/analyze-student-performance.mjs
# in the parent backend directory; turn off after collecting measurements.
SOPHIA_STUDENT_OPERATIONS_TIMING=0
SOPHIA_RUNTIME_JWT_SECRET=
SOPHIA_DEFAULT_CUSTOMER_ID=11111111-1111-4111-8111-111111111111
SOPHIA_DEFAULT_STORE_ID=demo-store
SOPHIA_DEFAULT_DEVICE_ID=
SOPHIA_ALLOWED_EXPERIENCES=essential,professional,premium
SOPHIA_SESSION_ACCESS_TTL_SECONDS=600
SOPHIA_MAX_CONCURRENT_SESSIONS=10
SOPHIA_MAX_TOOL_CALLS_PER_MINUTE=20
SOPHIA_PROVIDER_OPEN_TIMEOUT_MS=25000
SOPHIA_PROVIDER_CLOSE_TIMEOUT_MS=20000
SOPHIA_PROVIDER_SESSION_MAX_SECONDS=7200
SOPHIA_DISCONNECT_GRACE_SECONDS=120
SOPHIA_DEPLOYMENT_ENV=development
# Required only by explicit providers:provision/providers:reconcile jobs.
SOPHIA_PROVIDER_OPERATION_CUSTOMER_ID=
SOPHIA_PROVIDER_OPERATION_CONFIRM=
# Required only by providers:provision. Use a stable version that includes the
# configured canonical/legacy catalog mode, for example current-real-estate-tools-legacy.
SOPHIA_PROVIDER_CATALOG_VERSION=
SOPHIA_PROVIDER_RECONCILE_LIMIT=25
# V2 remains disabled unless the fixed runtime tenant is explicitly allowlisted.
SOPHIA_V2_CANARY_TENANT_IDS=
SOPHIA_V2_INSTALLATION_KEY=
SOPHIA_V2_BOOTSTRAP_TTL_SECONDS=120
SOPHIA_BUSINESS_PACKS=real-estate
SOPHIA_PROVIDER_CATALOG_MODE=legacy
AI_PROVIDER=openai-realtime
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REASONING_MODEL=gpt-5.4-mini
OPENAI_REASONING_TIMEOUT_MS=60000
OPENAI_REASONING_MAX_OUTPUT_TOKENS=4096
# Bounded-turn speech composition. PCM is signed 16-bit, little-endian, 24 kHz, mono.
OPENAI_AUDIO_API_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_SYNTHESIS_MODEL=gpt-4o-mini-tts
OPENAI_SYNTHESIS_VOICE=marin
OPENAI_SPEECH_TIMEOUT_MS=60000
OPENAI_TRANSCRIPTION_MAX_INPUT_BYTES=2880000
OPENAI_SYNTHESIS_MAX_OUTPUT_BYTES=12000000
OPENAI_RESEARCH_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_TIMEOUT_MS=45000
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_REASONING_MODEL=claude-sonnet-5
ANTHROPIC_REASONING_TIMEOUT_MS=60000
ANTHROPIC_REASONING_MAX_OUTPUT_TOKENS=4096
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_REASONING_MODEL=gemini-3.8-flash
GEMINI_REASONING_TIMEOUT_MS=60000
GEMINI_REASONING_MAX_OUTPUT_TOKENS=4096
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_TOKEN_TTL_SECONDS=600
GEMINI_LIVE_NEW_SESSION_TTL_SECONDS=60
OPENAI_REALTIME_VAD_THRESHOLD=0.75
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=300
OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=900
BUSINESS_MANAGER_API_URL=http://localhost:3300/api
# Use the same random 32+ character value as SOPHIA_RUNTIME_SERVICE_TOKEN on Business Manager.
BUSINESS_MANAGER_API_TOKEN=
# Dedicated private knowledge bucket. Do not reuse a public asset prefix/bucket.
SOPHIA_KNOWLEDGE_S3_BUCKET=
SOPHIA_KNOWLEDGE_S3_REGION=ap-southeast-2
# Optional for an S3-compatible private object store.
SOPHIA_KNOWLEDGE_S3_ENDPOINT=
SOPHIA_KNOWLEDGE_UPLOAD_TTL_SECONDS=300
SOPHIA_KNOWLEDGE_MAX_UPLOAD_BYTES=1048576
# Scanner contract: GET /health and POST /scan -> {status:"clean"|"infected",engine,signature?}.
SOPHIA_KNOWLEDGE_SCANNER_URL=
SOPHIA_KNOWLEDGE_SCANNER_TOKEN=
SOPHIA_KNOWLEDGE_SCAN_TIMEOUT_MS=15000
# Required by the separate tenant-scoped knowledge:file-worker process.
SOPHIA_KNOWLEDGE_WORKER_TENANT_ID=
# Sophia subscriptions are deliberately separate from legacy STRIPE_* one-time payments.
# stripe_live remains a separate release gate and does not enable Checkout by itself.
SOPHIA_BILLING_PROVIDER=disabled
SOPHIA_BILLING_PROVIDER_ACCOUNT_KEY=legacy-primary
# Independent live collection switches. Keep all false until the corresponding
# production gate is verified and explicitly authorised.
SOPHIA_BILLING_LIVE_CHECKOUT_ENABLED=false
SOPHIA_BILLING_LIVE_OVERAGE_ENABLED=false
SOPHIA_BILLING_LIVE_MILESTONE_ENABLED=false
SOPHIA_BILLING_STRIPE_SECRET_KEY=
SOPHIA_BILLING_STRIPE_WEBHOOK_SECRET=
SOPHIA_BILLING_STRIPE_PORTAL_CONFIGURATION_ID=
SOPHIA_BILLING_STRIPE_COMMITTED_PORTAL_CONFIGURATION_ID=
# JSON objects map the immutable plan UUID to its licensed base and Meter-backed overage Prices.
SOPHIA_BILLING_STRIPE_PRICE_MAPPINGS={}
SOPHIA_BILLING_STRIPE_INITIAL_PRICE_MAPPINGS={}
SOPHIA_BILLING_STRIPE_MILESTONE_PRICE_MAPPINGS={}
SOPHIA_BILLING_STRIPE_METERED_PRICE_MAPPINGS={}
SOPHIA_BILLING_STRIPE_OVERAGE_PRICE_MAPPINGS={}
# Semantic internal Meter key -> provider event_name; do not put provider names in plan definitions.
SOPHIA_BILLING_STRIPE_METER_BINDINGS={}
SOPHIA_BILLING_CHECKOUT_SUCCESS_URL=http://localhost:4200/sophia-admin/usage-billing?checkout=success
SOPHIA_BILLING_CHECKOUT_CANCEL_URL=http://localhost:4200/sophia-admin/usage-billing?checkout=cancelled
SOPHIA_BILLING_PORTAL_RETURN_URL=http://localhost:4200/sophia-admin/usage-billing
# Scoped multi-tenant connector credentials. Use the same secret/issuer/audience on Business Manager.
SOPHIA_CONNECTOR_SIGNING_SECRET=
SOPHIA_CONNECTOR_ISSUER=sophia-runtime
SOPHIA_CONNECTOR_AUDIENCE=business-manager
# Multi-tenant Xero OAuth 2.0 connection. Keep every value server-side.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3400/api/connectors/xero/v1/oauth/callback
XERO_RETURN_URL=http://localhost:4200/manager/company
# At least 32 random characters, used only to sign short-lived OAuth state.
XERO_OAUTH_STATE_SECRET=
# Base64-encoded 32-byte AES key. Generate with: openssl rand -base64 32
XERO_TOKEN_ENCRYPTION_KEY=
# Xero webhook signing key from the developer application. Server-side only.
XERO_WEBHOOK_KEY=
# Legacy in-API execution only. Disable after dedicated workers are verified.
XERO_SYNC_SCHEDULER_ENABLED=false
# Shared worker cutover requires Runtime migrations 080/081 and the identity
# migration. Set worker on API and shared worker; see the cutover runbook.
XERO_SYNC_EXECUTION_MODE=inline
# Opt-in durable per-connection cooldown shared by Accounting imports, document
# discovery/downloads and connection tests. Apply Runtime migration 082 first;
# then enable on BOTH Runtime API and shared worker. Not an app-wide quota.
XERO_SHARED_BACKOFF_ENABLED=false
# Opt-in source-level discovery/cache (24h metadata reuse), shared-worker only
# execution. Apply 083 first; enable on Runtime API (explicit refresh markers)
# and shared worker. Requires XERO_SHARED_BACKOFF_ENABLED=true on the worker.
STUDENT_DOCUMENT_SOURCE_DEDUP_ENABLED=false
# Atomic per-connection daily admission; apply 084 before enabling on BOTH
# Runtime API and shared worker. Requires both flags above. Owner-configured
# defaults: 1000 calls / 200 reserved for operations; not an app-wide limiter.
XERO_SHARED_QUOTA_ENABLED=false
# Shared worker only. Apply 085; requires quota/backoff/source dedup above.
# Queues <=25 unique changed/weekly-expired sources per customer/Brisbane day.
# No new provider allowance or expansion of the existing document window/cap.
STUDENT_DOCUMENT_RECHECKS_ENABLED=false
# Worker-only local health summaries, at most once per customer per 5 minutes.
# Requires shared quota/backoff/source dedup; no external alert delivery.
STUDENT_SYNC_HEALTH_LOGS_ENABLED=false
# Set true on the shared worker (not required on APIs). It hosts all three
# stages; stop legacy document cron before starting shared discovery.
STUDENT_SYNC_PIPELINE_ENABLED=false
# Shared-worker document tenant allowlist; copy UUID(s) from reviewed cron scope.
STUDENT_SYNC_DOCUMENT_CUSTOMER_IDS=
# Apply owner migrations 098 and 099 before enabling on BOTH Runtime API and shared worker.
# Requires STUDENT_DOCUMENT_ANALYSIS_ENABLED, STUDENT_OFFER_ANALYSIS_ENABLED and
# STUDENT_DOCUMENT_CHECKLIST_ENABLED exactly true. Initial policy is manual
# document approval; rejected latest documents put early cases on hold. Invoice
# preparation stores Sophia-only drafts and NEVER calls Xero invoice APIs.
# Shared worker caches TRUST Items/accounts/taxes daily using accounting.settings.read.
# The first successful catalogue import is required before saving invoice drafts.
STUDENT_DOCUMENT_WORKFLOW_ENABLED=false
AVATAR_PROVIDER=simli
SIMLI_API_KEY=
SIMLI_AVATAR_ID=
SIMLI_MAX_SESSION_LENGTH_SECONDS=600
SIMLI_MAX_IDLE_TIME_SECONDS=180
SIMLI_TRANSPORT_MODE=livekit
LIVEAVATAR_API_KEY=
LIVEAVATAR_API_BASE_URL=https://api.liveavatar.com
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_MODE=FULL
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_SANDBOX=true
LIVEAVATAR_MAX_SESSION_DURATION_SECONDS=60
TAVUS_API_KEY=
TAVUS_API_BASE_URL=https://tavusapi.com
TAVUS_PAL_ID=
TAVUS_FACE_ID=
# Legacy aliases are still accepted during deployment migration:
# TAVUS_PERSONA_ID=
# TAVUS_REPLICA_ID=
TAVUS_NATIVE_LLM_ONLY=false
TAVUS_INTERNET_SEARCH_ENABLED=true
