    "test:p0:real-estate": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --runTestsByPath tests/sophia.realEstate.characterization.test.js tests/bm.realEstateConfirmation.test.js tests/bm.realEstateBookingQueue.test.js tests/bm.inspectionWorkflow.test.js tests/bm.propertyReportJobs.test.js tests/bm.propertyReportWorker.test.js tests/bm.inspectionEmailWorker.test.js tests/bm.workflowHardening.test.js",
