FROM node:22-bookworm AS runtime-build
WORKDIR /build
COPY sophia-runtime/package*.json ./
RUN npm ci
COPY sophia-runtime/ ./
RUN npm run build

FROM node:22-bookworm
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev
COPY sophia-runtime/package*.json ./sophia-runtime/
RUN npm ci --omit=dev --prefix sophia-runtime
COPY src/ ./src/
COPY scripts/process-student-sync.mjs ./scripts/process-student-sync.mjs
COPY --from=runtime-build /build/dist ./sophia-runtime/dist
USER node
CMD ["node","scripts/process-student-sync.mjs"]
